# ==============================================================================
# voice-agent-starter-kit — environment configuration (CANONICAL)
# ------------------------------------------------------------------------------
# Copy this file to `.env` and fill in real values:
#     cp .env.example .env
#
# This file is the single source of truth for every variable the kit uses.
# Placeholders only — NEVER commit your real `.env` (it is in .gitignore).
# ==============================================================================


# --- LiveKit (media server + realtime + SIP) ---------------------------------
# Get these from the LiveKit Cloud dashboard (Settings → Keys), or from your
# self-hosted livekit.yaml. The URL is the WSS endpoint of your project.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=YOUR_LIVEKIT_API_KEY
LIVEKIT_API_SECRET=YOUR_LIVEKIT_API_SECRET
# The SIP signalling host. COPY IT FROM Dashboard → Telephony → SIP trunks →
# the "SIP URI" card. Do NOT derive it from LIVEKIT_URL (that is the #1 cause
# of "INVITE never arrives"). Include the :5060 port.
SIP_URI=<your-project-id>.sip.livekit.cloud:5060


# --- Sarvam AI (Indian-language STT + TTS) -----------------------------------
# One API key covers both Saaras (STT) and Bulbul (TTS). Get it at sarvam.ai.
SARVAM_API_KEY=YOUR_SARVAM_API_KEY
# Speech-to-text model (Saaras). codemix mode, 8 kHz, one language per call.
SARVAM_STT_MODEL=saaras:v3
# Text-to-speech model (Bulbul).
SARVAM_TTS_MODEL=bulbul:v3
# TTS voice. `simran` is a warm female voice that fits Maya's persona.
SARVAM_TTS_VOICE=simran


# --- OpenAI (the reasoning LLM) ----------------------------------------------
# API key from platform.openai.com. gpt-4.1-mini is cheap and fast enough for
# voice; it won our bake-off over larger/reasoning models (see docs/04-latency.md).
OPENAI_API_KEY=YOUR_OPENAI_API_KEY
OPENAI_LLM_MODEL=gpt-4.1-mini
# Lower temperature = more predictable, less rambling on a phone call.
OPENAI_TEMPERATURE=0.3
# Hard cap on reply length. Short replies = lower latency. 80–140 is the sweet spot.
MAX_TOKENS=140


# --- Agent behaviour ----------------------------------------------------------
# The agent_name the worker registers under. Dispatch rules route calls to this.
AGENT_NAME=maya
# Language the greeter starts in before it detects the caller's language.
DEFAULT_LANGUAGE=en
# Silero VAD minimum silence before end-of-utterance, in milliseconds.
# Lower = snappier turns but more risk of cutting the caller off. 150 is tuned.
VAD_MIN_SILENCE_MS=150


# --- Vobiz (telephony / SIP trunk provider) ----------------------------------
# The phone number (DID) callers dial. Vobiz often delivers it national /
# 0-prefixed (e.g. 0XXXXXXXXXX) rather than E.164 — see docs/03-vobiz-sip.md.
VOBIZ_DID=+91XXXXXXXXXX
# The SIP domain Vobiz gives you for the trunk.
VOBIZ_SIP_DOMAIN=sip.vobiz.example
# Trunk identifier from the Vobiz console.
VOBIZ_TRUNK_ID=YOUR_VOBIZ_TRUNK_ID
# Auth for OUTBOUND/transfer legs only. The LiveKit INBOUND trunk stays no-auth.
VOBIZ_AUTH_USERNAME=YOUR_VOBIZ_AUTH_USERNAME
VOBIZ_AUTH_PASSWORD=YOUR_VOBIZ_AUTH_PASSWORD
# Number Maya transfers to when a caller asks for a human agent.
DEFAULT_TRANSFER_NUMBER=+91XXXXXXXXXX


# --- Supabase (call logs + site-visit rows) — optional -----------------------
# A free Postgres project. Used by the n8n ETL, not the live audio path.
SUPABASE_URL=YOUR_SUPABASE_URL
SUPABASE_SERVICE_KEY=YOUR_SUPABASE_SERVICE_KEY


# --- n8n (event ETL workflow host) -------------------------------------------
# Base URL of your self-hosted n8n. The agent/webhooks post events here.
N8N_BASE_URL=https://n8n.your-vps.example
N8N_API_KEY=YOUR_N8N_API_KEY


# --- Telegram (owner alerts) — optional --------------------------------------
# Bot token from @BotFather and the chat id to DM when a site visit is booked.
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
TELEGRAM_CHAT_ID=YOUR_TELEGRAM_CHAT_ID


# --- Recording handler --------------------------------------------------------
# Shared secret the recording webhook must present to the localhost
# recording_handler before it downloads a file. Generate a long random string.
REC_TOKEN=YOUR_REC_TOKEN


# --- Object storage for recordings (optional) --------------------------------
# Leave commented to store recordings on the VPS filesystem
# (/opt/voice-agent/recordings). Uncomment to push to S3-compatible storage.
# S3_ENDPOINT_URL=https://s3.your-region.amazonaws.com
# S3_BUCKET=your-recordings-bucket
# S3_ACCESS_KEY_ID=YOUR_S3_ACCESS_KEY_ID
# S3_SECRET_ACCESS_KEY=YOUR_S3_SECRET_ACCESS_KEY
